{
  "info": {
    "name": "Baozi Store API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clienteId",
      "value": "1"
    },
    {
      "key": "produtoId",
      "value": "1"
    },
    {
      "key": "pedidoId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 - Criar Cliente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('clienteId', json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Gabriel de oliveira martins4709215\",\n  \"clienteDesde\": \"2026-09-14\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/clientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes"
          ]
        }
      }
    },
    {
      "name": "02 - Criar Produto",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('produtoId', json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Baozi Tradicional\",\n  \"preco\": 9.90,\n  \"estoque\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/produtos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos"
          ]
        }
      }
    },
    {
      "name": "03 - Criar Pedido",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('pedidoId', json.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": {{clienteId}},\n  \"produtoId\": {{produtoId}},\n  \"quantidade\": 3\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos"
          ]
        }
      }
    },
    {
      "name": "04 - Listar Clientes",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/clientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes"
          ]
        }
      }
    },
    {
      "name": "05 - Listar Produtos",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/produtos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos"
          ]
        }
      }
    },
    {
      "name": "06 - Listar Pedidos",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos"
          ]
        }
      }
    },
    {
      "name": "07 - Consultar Cliente por ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/clientes/{{clienteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "clientes",
            "{{clienteId}}"
          ]
        }
      }
    },
    {
      "name": "08 - Consultar Produto por ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/produtos/{{produtoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "produtos",
            "{{produtoId}}"
          ]
        }
      }
    },
    {
      "name": "09 - Consultar Pedido por ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/pedidos/{{pedidoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos",
            "{{pedidoId}}"
          ]
        }
      }
    },
    {
      "name": "10 - Apagar Pedido",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/pedidos/{{pedidoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "pedidos",
            "{{pedidoId}}"
          ]
        }
      }
    }
  ]
}
